\section{Parsing and formatting}

Blank lines are ignored. Malformed lines raise [[ValueError]].
A booking must have a start before its end.

<<parsing and formatting>>=
def parse_time(text):
    """Convert 'HH:MM' to minutes since midnight."""
    hours, minutes = text.strip().split(":")
    h, m = int(hours), int(minutes)
    if not (0 <= h <= 24 and 0 <= m < 60) or (h == 24 and m != 0):
        raise ValueError(f"invalid time: {text!r}")
    return h * 60 + m


def format_time(minutes):
    """Convert minutes since midnight to 'HH:MM'."""
    return f"{minutes // 60:02d}:{minutes % 60:02d}"


def parse_slot(line):
    """Convert 'HH:MM-HH:MM' to a (start, end) pair of minutes."""
    try:
        start_text, end_text = line.strip().split("-")
        start, end = parse_time(start_text), parse_time(end_text)
    except ValueError:
        raise ValueError(f"invalid slot: {line.strip()!r}") from None
    if start >= end:
        raise ValueError(f"slot must start before it ends: {line.strip()!r}")
    return start, end


def format_slot(slot):
    return f"{format_time(slot[0])}-{format_time(slot[1])}"
@

\section{Computing the free slots}

<<computing free slots>>=
def free_slots(bookings, day_start=DAY_START, day_end=DAY_END):
    """Return the free (start, end) pairs within the day, in order."""
    free = []
    pos = day_start
    for start, end in sorted(bookings):
        if start > pos:
            free.append((pos, min(start, day_end)))
        pos = max(pos, end)
        if pos >= day_end:
            break
    if pos < day_end:
        free.append((pos, day_end))
    return free
@

The [[min]] ensures a booking starting after closing time does not
produce a gap extending past the day; such a gap would start at [[pos]]
and be cut to [[day_end]]. If [[pos]] is already at or past [[day_end]] we
stop. Since [[pos < day_end]] holds inside the loop, the gap is never
inverted.

\section{Main program}

<<main>>=
def main(stdin=None, stdout=None):
    stdin = stdin or sys.stdin
    stdout = stdout or sys.stdout
    bookings = [parse_slot(line) for line in stdin if line.strip()]
    for slot in free_slots(bookings):
        print(format_slot(slot), file=stdout)


if __name__ == "__main__":
    try:
        main()
    except ValueError as error:
        sys.exit(f"error: {error}")
@

